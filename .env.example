# Copia este archivo como ".env" (en la carpeta del proyecto) y completa los valores.
# El archivo .env NO se sube a git. En un servidor, define estas mismas variables de entorno.

# Base de datos (Supabase > Project Settings > Database > Connection string, modo "Session pooler")
SUPABASE_DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Almacenamiento de fotos (Supabase > Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Firma de la cookie "Recordarme": una cadena larga y al azar (48+ caracteres)
SAPHIKUNA_REMEMBER_KEY=

# Opcionales
# SAPHIKUNA_ADMIN_PASSWORD=   clave del primer administrador (si no, se genera y sale en el log)
# SAPHIKUNA_STORE_URL=        enlace a la app de ventas (tiene un valor por defecto)
